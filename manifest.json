{
  "name": "マス王 (Mas-King)",
  "short_name": "マス王",
  "description": "完全安全ローカル完結の画像マスキングツール",
  "start_url": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/icon-masking (1).png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-masking.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
 "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "image",
          "accept": ["image/*", ".png", ".jpg", ".jpeg", ".webp", ".mask"]
        }
      ]
    }
  }
}
